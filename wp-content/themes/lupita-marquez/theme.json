{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ivory", "color": "#fbf8f2", "name": "Marfil" },
        { "slug": "white", "color": "#ffffff", "name": "Blanco" },
        { "slug": "charcoal", "color": "#292522", "name": "Carbón" },
        { "slug": "wood", "color": "#a47d36", "name": "Oro artesanal" },
        { "slug": "olive", "color": "#514a31", "name": "Olivo profundo" },
        { "slug": "sand", "color": "#e5d7c6", "name": "Arena" },
        { "slug": "mist", "color": "#f5ede2", "name": "Niebla" },
        { "slug": "fuchsia", "color": "#bd155d", "name": "Fucsia" },
        { "slug": "muted", "color": "#6b625c", "name": "Texto secundario" },
        { "slug": "notice-background", "color": "#fff0b8", "name": "Aviso · fondo" },
        { "slug": "notice-border", "color": "#c9a93d", "name": "Aviso · borde" },
        { "slug": "notice-text", "color": "#493c0b", "name": "Aviso · texto" },
        { "slug": "success", "color": "#27623a", "name": "Éxito" },
        { "slug": "error", "color": "#a51e31", "name": "Error" },
        { "slug": "danger", "color": "#96202d", "name": "Peligro" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1280px" },
    "spacing": {
      "blockGap": true,
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "05", "size": "0.25rem", "name": "0.5" },
        { "slug": "10", "size": "0.5rem", "name": "1" },
        { "slug": "15", "size": "0.75rem", "name": "1.5" },
        { "slug": "20", "size": "0.44rem", "name": "2" },
        { "slug": "25", "size": "1.25rem", "name": "2.5" },
        { "slug": "30", "size": "0.67rem", "name": "3" },
        { "slug": "35", "size": "1.75rem", "name": "3.5" },
        { "slug": "40", "size": "1rem", "name": "4" },
        { "slug": "45", "size": "2.5rem", "name": "5" },
        { "slug": "50", "size": "1.5rem", "name": "6" },
        { "slug": "55", "size": "3.5rem", "name": "7" },
        { "slug": "60", "size": "2.25rem", "name": "8" },
        { "slug": "65", "size": "5rem", "name": "10" },
        { "slug": "70", "size": "3.38rem", "name": "Sección" },
        { "slug": "gutter", "size": "clamp(1rem, 3vw, 2.5rem)", "name": "Margen lateral" },
        { "slug": "content-gap", "size": "clamp(1.25rem, 2.5vw, 2rem)", "name": "Ritmo de contenido" },
        { "slug": "section-heading", "size": "clamp(2rem, 5vw, 4.5rem)", "name": "Encabezado de sección" },
        { "slug": "editorial-gap", "size": "clamp(2rem, 6vw, 6rem)", "name": "Ritmo editorial" },
        { "slug": "navigation-gap", "size": "1.5rem", "name": "Separación de navegación" },
        { "slug": "product-gap", "size": "clamp(3rem, 5vw, 5rem)", "name": "Ritmo de producto" },
        { "slug": "footer-gap", "size": "clamp(2rem, 7vw, 6rem)", "name": "Ritmo de pie" },
        { "slug": "drawer-padding", "size": "clamp(1.5rem, 6vw, 2.25rem)", "name": "Relleno de cajón" },
        { "slug": "hero-copy-tablet", "size": "clamp(2.5rem, 8vw, 4rem)", "name": "Relleno hero adaptable" },
        { "slug": "hero-copy-mobile", "size": "2.4rem", "name": "Relleno hero móvil" },
        { "slug": "footer-padding", "size": "clamp(2.5rem, 5vw, 3.5rem)", "name": "Relleno superior de pie" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": { "minViewportWidth": "320px", "maxViewportWidth": "1280px" },
      "fontFamilies": [
        {
          "fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
          "name": "Manrope",
          "slug": "sans",
          "fontFace": [{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "src": ["file:./assets/fonts/Manrope-Variable.ttf"] }]
        },
        {
          "fontFamily": "Fraunces, Georgia, serif",
          "name": "Fraunces",
          "slug": "serif",
          "fontFace": [{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "src": ["file:./assets/fonts/Fraunces-Variable.ttf"] }]
        }
      ],
      "fontSizes": [
        { "slug": "micro", "size": "0.75rem", "name": "Micro" },
        { "slug": "caption", "size": "0.8125rem", "name": "Pie de foto" },
        { "slug": "small", "size": "0.875rem", "fluid": { "min": "0.8125rem", "max": "0.875rem" }, "name": "Pequeño" },
        { "slug": "medium", "size": "1rem", "fluid": { "min": "0.9375rem", "max": "1rem" }, "name": "Mediano" },
        { "slug": "large", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" }, "name": "Grande" },
        { "slug": "lead", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" }, "name": "Introducción" },
        { "slug": "menu", "size": "0.875rem", "name": "Navegación" },
        { "slug": "card-title", "size": "1.125rem", "name": "Título de tarjeta" },
        { "slug": "category-link-icon", "size": "3.3rem", "fluid": { "min": "2.4rem", "max": "3.3rem" }, "name": "Icono de enlace de categoría" },
        { "slug": "drawer-link", "size": "1.35rem", "fluid": { "min": "1.15rem", "max": "1.35rem" }, "name": "Enlace de menú móvil" },
        { "slug": "section-title", "size": "2.625rem", "fluid": { "min": "2rem", "max": "2.625rem" }, "name": "Título de sección" },
        { "slug": "x-large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" }, "name": "Título" },
        { "slug": "product-title", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" }, "name": "Título de producto" },
        { "slug": "product-section-title", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" }, "name": "Título de sección de producto" },
        { "slug": "product-utility-title", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "1.75rem" }, "name": "Título funcional de producto" },
        { "slug": "mini-cart-title", "size": "1.5rem", "fluid": { "min": "1.375rem", "max": "1.5rem" }, "name": "Título de minicart" },
        { "slug": "product-price", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" }, "name": "Precio de producto" },
        { "slug": "price", "size": "1.6rem", "fluid": { "min": "1.25rem", "max": "1.6rem" }, "name": "Precio" },
        { "slug": "display", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" }, "name": "Portada" }
      ],
      "lineHeight": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": { "background": "var:preset|color|ivory", "text": "var:preset|color|charcoal" },
    "spacing": {
      "blockGap": "var:preset|spacing|30",
      "padding": { "left": "0", "right": "0" }
    },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|fuchsia", "text": "var:preset|color|white" },
        "spacing": { "padding": { "top": "var:preset|spacing|15", "right": "var:preset|spacing|30", "bottom": "var:preset|spacing|15", "left": "var:preset|spacing|30" } },
        "typography": { "fontSize": "var:preset|font-size|menu", "fontWeight": "700" }
      },
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "560", "letterSpacing": "-0.025em", "lineHeight": "1.08" } },
      "link": { "color": { "text": "var:preset|color|charcoal" }, "typography": { "textDecoration": "none" } }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "var:preset|font-size|menu", "fontWeight": "650" } },
      "core/site-title": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "var:preset|font-size|section-title", "fontWeight": "600" } },
      "core/image": { "border": { "radius": "var:preset|spacing|20" } },
      "woocommerce/product-price": { "color": { "text": "var:preset|color|fuchsia" }, "typography": { "fontWeight": "750" } }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Encabezado" },
    { "area": "footer", "name": "footer", "title": "Pie de página" }
  ]
}
