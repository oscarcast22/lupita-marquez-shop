{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "ivory", "color": "#fbf8f2", "name": "Marfil" },
        { "slug": "white", "color": "#ffffff", "name": "Blanco" },
        { "slug": "charcoal", "color": "#292522", "name": "Carbón" },
        { "slug": "wood", "color": "#a47d36", "name": "Oro artesanal" },
        { "slug": "olive", "color": "#514a31", "name": "Olivo profundo" },
        { "slug": "sand", "color": "#e5d7c6", "name": "Arena" },
        { "slug": "mist", "color": "#f5ede2", "name": "Niebla" },
        { "slug": "fuchsia", "color": "#bd155d", "name": "Fucsia" },
        { "slug": "muted", "color": "#6b625c", "name": "Texto secundario" },
        { "slug": "notice-background", "color": "#fff0b8", "name": "Aviso · fondo" },
        { "slug": "notice-border", "color": "#c9a93d", "name": "Aviso · borde" },
        { "slug": "notice-text", "color": "#493c0b", "name": "Aviso · texto" },
        { "slug": "success", "color": "#27623a", "name": "Éxito" },
        { "slug": "error", "color": "#a51e31", "name": "Error" },
        { "slug": "danger", "color": "#96202d", "name": "Peligro" }
      ]
    },
    "layout": { "contentSize": "720px", "wideSize": "1280px" },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["px", "rem", "vw", "%"],
      "spacingSizes": [
        { "slug": "05", "size": "0.25rem", "name": "0.5" },
        { "slug": "10", "size": "0.5rem", "name": "1" },
        { "slug": "15", "size": "0.75rem", "name": "1.5" },
        { "slug": "20", "size": "1rem", "name": "2" },
        { "slug": "25", "size": "1.25rem", "name": "2.5" },
        { "slug": "30", "size": "1.5rem", "name": "3" },
        { "slug": "35", "size": "1.75rem", "name": "3.5" },
        { "slug": "40", "size": "2rem", "name": "4" },
        { "slug": "45", "size": "2.5rem", "name": "5" },
        { "slug": "50", "size": "3rem", "name": "6" },
        { "slug": "55", "size": "3.5rem", "name": "7" },
        { "slug": "60", "size": "4rem", "name": "8" },
        { "slug": "65", "size": "5rem", "name": "10" },
        { "slug": "70", "size": "clamp(4.5rem, 8vw, 8rem)", "name": "Sección" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": { "minViewportWidth": "320px", "maxViewportWidth": "1280px" },
      "fontFamilies": [
        {
          "fontFamily": "Manrope, ui-sans-serif, system-ui, sans-serif",
          "name": "Manrope",
          "slug": "sans",
          "fontFace": [{ "fontFamily": "Manrope", "fontStyle": "normal", "fontWeight": "200 800", "src": ["file:./assets/fonts/Manrope-Variable.ttf"] }]
        },
        {
          "fontFamily": "Fraunces, Georgia, serif",
          "name": "Fraunces",
          "slug": "serif",
          "fontFace": [{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "src": ["file:./assets/fonts/Fraunces-Variable.ttf"] }]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.84375rem", "fluid": { "min": "0.78125rem", "max": "0.84375rem" }, "name": "Pequeño" },
        { "slug": "medium", "size": "1rem", "fluid": { "min": "0.9375rem", "max": "1rem" }, "name": "Mediano" },
        { "slug": "large", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" }, "name": "Grande" },
        { "slug": "x-large", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" }, "name": "Título" }
      ],
      "lineHeight": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": { "background": "var:preset|color|ivory", "text": "var:preset|color|charcoal" },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": { "left": "0", "right": "0" }
    },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
    "elements": {
      "button": {
        "color": { "background": "var:preset|color|fuchsia", "text": "var:preset|color|white" },
        "spacing": { "padding": { "top": "0.72rem", "right": "1.4rem", "bottom": "0.72rem", "left": "1.4rem" } },
        "typography": { "fontSize": "0.84rem", "fontWeight": "700" }
      },
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "560", "letterSpacing": "-0.025em", "lineHeight": "1.08" } },
      "link": { "color": { "text": "var:preset|color|charcoal" }, "typography": { "textDecoration": "none" } }
    },
    "blocks": {
      "core/navigation": { "typography": { "fontSize": "0.84rem", "fontWeight": "650" } },
      "core/site-title": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontSize": "clamp(1.35rem, 2vw, 1.8rem)", "fontWeight": "600" } },
      "core/image": { "border": { "radius": "16px" } },
      "woocommerce/product-price": { "color": { "text": "var:preset|color|fuchsia" }, "typography": { "fontWeight": "750" } }
    }
  },
  "templateParts": [
    { "area": "header", "name": "header", "title": "Encabezado" },
    { "area": "footer", "name": "footer", "title": "Pie de página" }
  ]
}
